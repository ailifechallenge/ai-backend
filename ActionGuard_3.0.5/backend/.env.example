GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after verifying your project is Free tier in AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
NWS_USER_AGENT=ActionGuardTravel/2.0 (replace-with-your-contact-email)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_DAILY_CALL_LIMIT=40

# 지도·도보·자동차 경로에는 Google API 키가 필요하지 않습니다.

# Push is explicitly disabled until opted in. dry_run never transmits device tokens.
PUSH_MODE=disabled
# PUSH_DATABASE=/private-persistent-volume/push.sqlite3
PUSH_FCM_PROJECT_ID=
PUSH_FCM_SERVICE_ACCOUNT_FILE=
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_ID=
PUSH_APNS_TOPIC=
PUSH_APNS_KEY_FILE=
PUSH_APNS_SANDBOX=false
