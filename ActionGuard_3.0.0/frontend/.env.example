# 이 파일을 .env.local 로 복사해 값을 바꿔 쓰세요. (.env*.local 은 커밋되지 않습니다)
# 비밀값(API 키 등)은 프론트에 두지 않습니다. VITE_* 값은 브라우저 번들에 그대로 들어갑니다.

# live: FastAPI 백엔드(/api) 호출 · mock: src/mocks 시연 데이터 (?scenario= 사용)
# 비우거나 다른 값이면 live로 동작합니다. live 실패 시 mock으로 자동 전환하지 않습니다.
VITE_API_MODE=live

# 경보 조회 지역. 비우면 데모 좌표(Houston, TX)로 조회합니다.
# 좌표 조회는 활성 경보가 없을 때가 많으니, 테스트할 때는 TX 같은 미국 주 코드(2글자)를 넣어 보세요.
VITE_ALERT_AREA=

# 개발 서버(npm run dev)가 /api 요청을 넘길 로컬 백엔드 포트
ACTIONGUARD_BACKEND_PORT=8000
